# ==============================================================================
# DPIG Environment Variables for Vercel Deployment
# Add these in Vercel Dashboard -> Settings -> Environment Variables
# ==============================================================================

# Core Django Settings
DJANGO_SECRET_KEY=change-to-a-secure-50-character-random-secret-for-vercel-2026
DJANGO_DEBUG=False
ENABLE_DEMO_ROLE_SWITCHER=False

# Host & Security Origins (Vercel wildcards are included by default)
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# ------------------------------------------------------------------------------
# Database: Serverless PostgreSQL (Required on Vercel)
# Compatible with Neon, Supabase, Railway, Tembo, or Cloud SQL / RDS
# Example: postgres://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME?sslmode=require

# Google Gemini AI Service
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash

# Google Maps Platform (Geocoding & Maps JavaScript API)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Email Notification Gateway (Optional for Staging)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-service-account@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-google-app-password
DEFAULT_FROM_EMAIL=Digital Public Infrastructure Portal <noreply@dpig.gov.in>
NOTIFICATION_FALLBACK_EMAIL=admin@dpig.gov.in

# Internal Machine-to-Machine API & Webhook Secret
INTERNAL_API_KEY=dpig-secure-cron-token-vercel-2026
