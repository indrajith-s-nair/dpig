# ==============================================================================
# DPIG Staging Environment Configuration (<5k MAU Tier)
# Google Cloud Run + Firebase Hosting
# ==============================================================================

# Core Django Settings
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-for-staging-2026
DJANGO_DEBUG=False
ENABLE_DEMO_ROLE_SWITCHER=False

# Host & Security Origins (Add your custom domain if configured)
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://*.web.app,https://*.firebaseapp.com,https://*.run.app

# ------------------------------------------------------------------------------
# Database Option A: Google Cloud SQL (PostgreSQL 16 with PostGIS) - Recommended
# ------------------------------------------------------------------------------
USE_SQLITE=False
DB_ENGINE=django.db.backends.postgresql
CLOUD_SQL_CONNECTION_NAME=YOUR_GCP_PROJECT_ID:asia-south1:dpig-sql-staging
POSTGRES_DB=dpig_db
POSTGRES_USER=dpig_user
POSTGRES_PASSWORD=YOUR_STRONG_SQL_PASSWORD

# ------------------------------------------------------------------------------
# Database Option B: Persistent SQLite (Zero Additional Cost for Dev Staging)
# To use Option B, uncomment the lines below and comment Option A above:
# USE_SQLITE=True
# SQLITE_PATH=/app/db.sqlite3
# ------------------------------------------------------------------------------

# Database Migrations on Startup (Set to 'true' to auto-apply migrations on deployment)
RUN_MIGRATIONS=true
SEED_DEMO_DATA=false

# Google Gemini AI Service
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash

# Google Maps Platform (Geocoding & Maps JavaScript API)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Email Notification Gateway (Gmail SMTP / Google Workspace)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-service-account@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-google-app-password
DEFAULT_FROM_EMAIL=Digital Public Infrastructure Portal <noreply@dpig.gov.in>
NOTIFICATION_FALLBACK_EMAIL=admin@dpig.gov.in

# Internal Machine-to-Machine API & Cloud Scheduler Cron Key
INTERNAL_API_KEY=dpig-secure-cron-token-staging-2026

# Gunicorn Concurrency (1 vCPU / 1GB RAM)
WEB_CONCURRENCY=2
